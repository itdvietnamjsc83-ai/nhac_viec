{
  "name": "nhac-viec",
  "productName": "Nhắc Việc",
  "version": "1.3.1",
  "description": "Phần mềm nhắc việc cho Windows và macOS, nhập tiến độ dự án từ file Excel mẫu",
  "main": "src/main.js",
  "author": "Dũng",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "template": "node scripts/make-template.js",
    "test": "node scripts/test-import.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "smoke": "electron . --smoke-test"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "vn.nhacviec.app",
    "productName": "NhacViec",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/mau-tien-do-du-an.xlsx",
        "to": "mau-tien-do-du-an.xlsx"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "NhacViec"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nhắc Việc",
      "uninstallDisplayName": "Nhắc Việc"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "LSMinimumSystemVersion": "11.0",
        "CFBundleDisplayName": "Nhắc Việc"
      },
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "artifactName": "NhacViec-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "dmg": {
      "title": "Nhắc Việc ${version}",
      "contents": [
        {
          "x": 140,
          "y": 190
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "compression": "maximum"
  }
}
